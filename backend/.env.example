# ─── App Configuration ──────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated. Include both hostname spellings the frontend might be
# opened with — a request from http://127.0.0.1:3000 is rejected by the
# browser if only http://localhost:3000 is listed here, even though it's
# "the same" dev server, because CORS matches the Origin header exactly.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3010,http://127.0.0.1:3010

# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
# SQLite fallback is opt-in; it must not silently replace PostgreSQL.
USE_SQLITE_FALLBACK=false
DATABASE_URL=postgresql+asyncpg://nexmarket:nexmarket@localhost:5432/nexmarket_db
SYNC_DATABASE_URL=postgresql://nexmarket:nexmarket@localhost:5432/nexmarket_db

# ─── Security ───────────────────────────────────────────────────────────────
# Change this in production!
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
APP_API_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Options: openai, local
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-...

# ─── Image Generation ───────────────────────────────────────────────────────
# Options: openai, stability, mock, local
# mock   = returns placeholder images (good for development)
# local  = SDXL renders background art, the composer typesets all text on top
IMAGE_PROVIDER=mock
STABILITY_API_KEY=

# ─── Marketing copy / evaluation provider ───────────────────────────────────
# Which models write marketing COPY and score posters: poster brochure copy,
# the SDXL scene spec, poster evaluation, and ad copy.
#   local  = Qwen2.5-3B + Qwen2.5-VL
# Sentiment, lead scoring and forecasting are NOT affected — they follow
# LLM_PROVIDER / VISION_PROVIDER.
#
# Qwen2.5-3B at 4-bit cannot produce usable non-English text: it mistranslated
# brand names on posters, and for ad copy it failed to emit parseable JSON for
# Tamil entirely, silently falling back to a hardcoded English template.
#
# Renamed from POSTER_PHASE_PROVIDER (which is still read, for existing .env
# files) once ad copy started sharing the same switch.
AI_TEXT_PROVIDER=local

# ─── Vision Model ───────────────────────────────────────────────────────────
# For evaluating generated posters
VISION_PROVIDER=openai
VISION_MODEL=gpt-4o

# ─── Social Media Integration ───────────────────────────────────────────────
# Set SOCIAL_MODE=live to actually post; mock = simulate posting
SOCIAL_MODE=mock

# Meta (Instagram, Facebook)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_PAGE_ID=

# Telegram Bot API — https://core.telegram.org/bots/api
#   1. Create a bot with @BotFather, copy the token
#   2. Add the bot to your channel/group as an administrator
#   3. TELEGRAM_CHAT_ID is the channel @username or the numeric chat id
# The only live platform that does NOT need a public media URL: its adapter
# uploads the poster bytes directly via multipart.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Business Cloud API — https://developers.facebook.com/docs/whatsapp
# Business message distribution, not broadcast posting: each send targets one
# recipient. Outside the 24h customer-service window Meta only permits
# pre-approved templates.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_RECIPIENT=

# Base URL social platforms fetch generated posters from. Falls back to
# STATIC_BASE_URL when blank.
#
# IMPORTANT for SOCIAL_MODE=live: Instagram, Facebook and WhatsApp fetch the
# image server-side, so this MUST be publicly reachable. A localhost URL will
# fail — point it at a tunnel (ngrok/cloudflared) or real hosting. Telegram is
# exempt (direct upload). Mock mode is unaffected.
PUBLIC_MEDIA_BASE_URL=

# ─── n8n Orchestration ──────────────────────────────────────────────────────
# Optional: Leave empty if not using n8n
N8N_WEBHOOK_BASE=http://localhost:5678/webhook
N8N_API_KEY=
TELEGRAM_WEBHOOK_SECRET=
ALLOW_INSECURE_WEBHOOKS=false

# ─── Storage ────────────────────────────────────────────────────────────────
# Options: local, s3
STORAGE_BACKEND=local
POSTER_UPLOAD_DIR=./assets/posters
STATIC_BASE_URL=http://localhost:8000/static
