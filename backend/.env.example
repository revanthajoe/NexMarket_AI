# ─── App Configuration ──────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgresql+asyncpg://nexmarket:nexmarket@localhost:5432/nexmarket_db
SYNC_DATABASE_URL=postgresql://nexmarket:nexmarket@localhost:5432/nexmarket_db

# ─── Security ───────────────────────────────────────────────────────────────
# Change this in production!
SECRET_KEY=your-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Options: openai, gemini, local
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# ─── Image Generation ───────────────────────────────────────────────────────
# Options: openai, stability, mock, local
# mock = returns placeholder images (good for development)
IMAGE_PROVIDER=mock
STABILITY_API_KEY=

# ─── Vision Model ───────────────────────────────────────────────────────────
# For evaluating generated posters
VISION_PROVIDER=openai
VISION_MODEL=gpt-4o

# ─── Social Media Integration ───────────────────────────────────────────────
# Set SOCIAL_MODE=live to actually post; mock = simulate posting
SOCIAL_MODE=mock

# Meta (Instagram, Facebook)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_PAGE_ID=

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_ORG_URN=

# Twitter
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ─── n8n Orchestration ──────────────────────────────────────────────────────
# Optional: Leave empty if not using n8n
N8N_WEBHOOK_BASE=http://localhost:5678/webhook
N8N_API_KEY=

# ─── Storage ────────────────────────────────────────────────────────────────
# Options: local, s3
STORAGE_BACKEND=local
POSTER_UPLOAD_DIR=./assets/posters
STATIC_BASE_URL=http://localhost:8002/static
