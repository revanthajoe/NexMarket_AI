# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nexmarket:nexmarket@localhost:5432/nexmarket_db
SYNC_DATABASE_URL=postgresql://nexmarket:nexmarket@localhost:5432/nexmarket_db

# ─── Security ────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── LLM / Generative AI ─────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
# Which provider to use: openai | gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# ─── Image Generation ────────────────────────────────────────
# Provider: openai | stability | mock
IMAGE_PROVIDER=openai
STABILITY_API_KEY=sk-...

# ─── Vision LLM (Poster Evaluator) ───────────────────────────
VISION_PROVIDER=openai
VISION_MODEL=gpt-4o

# ─── Social Media ────────────────────────────────────────────
# Set SOCIAL_MODE=mock for demo without real credentials
SOCIAL_MODE=mock

# Instagram / Facebook (Meta Graph API)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_PAGE_ID=

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_ORG_URN=

# Twitter / X
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ─── n8n ──────────────────────────────────────────────────────
N8N_WEBHOOK_BASE=http://localhost:5678/webhook
N8N_API_KEY=

# ─── Storage ─────────────────────────────────────────────────
STORAGE_BACKEND=local
POSTER_UPLOAD_DIR=./assets/posters
STATIC_BASE_URL=http://localhost:8000/static

# ─── ML Models ───────────────────────────────────────────────
LSTM_MODEL_PATH=./ml/lstm/engagement_lstm.h5
XGBOOST_MODEL_PATH=./ml/xgboost_model/lead_model.json

# ─── Sentiment ───────────────────────────────────────────────
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english

# ─── App ─────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
