# Backend API URL (required)
# Development (local): http://127.0.0.1:8000/api/v1
# Production: https://api.nexmarket.com/api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# Shared perimeter key for sensitive/mutating backend calls. This is public
# browser configuration, not a user or privileged server secret.
NEXT_PUBLIC_APP_API_KEY=
